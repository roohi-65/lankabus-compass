      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10243A"
      },
      "package": "com.lankabus.compass"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ]
  }
}
